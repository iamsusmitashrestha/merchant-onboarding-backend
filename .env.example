# Copy to .env and replace every "change-me" value. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Postgres (host port 5433 to avoid clashing with other local Postgres instances)
DB_HOST=localhost
DB_PORT=5433
DB_USER=merchant
DB_PASSWORD=change-me-local-db-password
DB_NAME=merchant_onboarding

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
BULL_PREFIX=mo

# Auth — JWT_SECRET must be >= 32 chars; generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_EXPIRES_IN_SECONDS=900

# Used only by `npm run seed` for the fake demo users
SEED_USER_PASSWORD=change-me-seed-password

# Risk review (BullMQ job + simulated KYB provider)
RISK_JOB_ATTEMPTS=5
RISK_JOB_BACKOFF_MS=2000
RISK_SIM_LATENCY_MS=300
RISK_SIM_FAILURE_RATE=0.2
