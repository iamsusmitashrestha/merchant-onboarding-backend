# Copy to .env.test for `npm run test:e2e`. Uses a separate database and queue prefix.
NODE_ENV=test
PORT=3001
LOG_LEVEL=silent

DB_HOST=localhost
DB_PORT=5433
DB_USER=merchant
DB_PASSWORD=change-me-local-db-password
DB_NAME=merchant_onboarding_test

REDIS_HOST=localhost
REDIS_PORT=6379
BULL_PREFIX=test

JWT_SECRET=change-me-test-secret-at-least-32-characters-long
JWT_EXPIRES_IN_SECONDS=900

SEED_USER_PASSWORD=change-me-test-seed-password

# Risk review: no random failures, fast retries so the failure path takes milliseconds
RISK_JOB_ATTEMPTS=3
RISK_JOB_BACKOFF_MS=10
RISK_SIM_LATENCY_MS=0
RISK_SIM_FAILURE_RATE=0

# Login throttling: high enough for the suites, low enough for the 429 test
LOGIN_THROTTLE_LIMIT=10
LOGIN_THROTTLE_TTL_SECONDS=60
